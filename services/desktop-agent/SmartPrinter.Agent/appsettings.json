{
  "Agent": {
    "DataDirectory": "%PROGRAMDATA%\\SmartPrinter\\Agent",
    "PipeName": "SmartPrinterAgentPipe",
    "LastSeenIntervalSeconds": 300,
    "RealtimeReconnectMinBackoffSeconds": 1,
    "RealtimeReconnectMaxBackoffSeconds": 60,
    "JobDownloadTimeoutSeconds": 60,
    "JobRetryLimit": 3,
    "TempFileDirectory": "%PROGRAMDATA%\\SmartPrinter\\Agent\\temp",
    "MaxDownloadFileSizeBytes": 52428800,
    "AllowedFileExtensions": [ ".pdf" ],
    "MockCloudMode": false
  },
  "Supabase": {
    "Url": "",
    "AnonKey": "",
    "PrintJobsTable": "print_jobs",
    "PrintJobEventsTable": "print_job_events",
    "PrintersTable": "printers",
    "DevicesTable": "devices",
    "StorageBucket": "print-uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
